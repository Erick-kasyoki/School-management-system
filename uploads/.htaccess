# Uploaded photos are static files only — never execute anything from here.
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php8.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php5 .php7 .phps
<FilesMatch "\.(php|phtml|phar|pl|py|cgi)$">
  Require all denied
</FilesMatch>
Options -Indexes

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
